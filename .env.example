# Copy to .env.local and fill in real values. NEVER commit real secrets.
# These are server-only vars — never prefix with NEXT_PUBLIC_.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
CUSTOMER_SESSION_SECRET="replace-with-another-long-random-secret"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_APP_PASSWORD="your-16-character-app-password"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Separate secret configured on the Razorpay webhook (payment.captured/order.paid).
RAZORPAY_WEBHOOK_SECRET=""
# Set to 0 to roll the homepage back to the previous hero.
HOMEPAGE_HERO_V2="1"
